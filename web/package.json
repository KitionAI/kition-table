{
  "name": "kition-table-ui",
  "version": "0.4.0",
  "private": true,
  "description": "The Table kit's editor (Kition platform `docs/platform/kits/ui.md`): the table editor, its UI primitives, theme, strings, and templates over the kit's engine, embedded by hosts over the Kit UI protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "engine": "sh scripts/build-engine.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:flow": "node tests/flow.mjs chromium && node tests/flow.mjs webkit",
    "test:modes": "node tests/modes.mjs chromium && node tests/modes.mjs webkit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@kition/kit-dev-host": "^0.1.0",
    "@kition/kit-host": "^0.1.0",
    "@kition/kit-ui-protocol": "^0.1.0",
    "@kition/kit-editor": "^0.1.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "lodash-es": "^4.17.21",
    "lru-cache": "10.2.0",
    "@kition/tessera-icons": "^0.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-grid-layout": "^2.2.3",
    "react-hammerjs": "1.0.1",
    "react-hotkeys-hook": "^5.3.2",
    "react-i18next": "^17.0.8",
    "react-resizable": "^3.2.0",
    "scroller": "0.0.3",
    "tailwind-merge": "^3.5.0",
    "ts-key-enum": "2.0.12",
    "ts-keycode-enum": "1.0.6",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/hammerjs": "^2.0.46",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/scroller": "^0.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "playwright": "1.59.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
